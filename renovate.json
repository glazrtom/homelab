{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Prague",
  "automerge": false,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "additionalBranchPrefix": "{{parentDir}}-",
  "ignorePaths": [
    "debug/**",
    "vpn/**",
    "init.sh"
  ],
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)values(-[^/]+)?\\.ya?ml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "/^applications/.+\\.yaml$/",
      "/^media/application/Application\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ingress/values\\.yaml$/"
      ],
      "matchStrings": [
        "name:\\s*(?<depName>ingress-nginx)\\s*\\n\\s*repo:\\s*(?<registryUrl>\\S+)\\s*\\n\\s*version:\\s*\"?(?<currentValue>[^\"\\s]+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^argocd/install/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/argoproj/argo-cd/(?<currentValue>v[0-9.]+)/manifests/install\\.yaml"
      ],
      "depNameTemplate": "argoproj/argo-cd",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Only edits the role default; the new k3s version takes effect when the ansible k3s role is next run.",
      "managerFilePatterns": [
        "/^ansible/roles/k3s/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "k3s_version:\\s*(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "ArgoCD Applications that just point back at this same repo with targetRevision: HEAD aren't a real dependency to bump - only reflector's remote Helm chart is.",
      "matchManagers": ["argocd"],
      "matchDepNames": ["https://github.com/glazrtom/homelab.git"],
      "enabled": false
    },
    {
      "description": "Pi-hole uses calver YYYY.MM.N; point at the actual image source for changelogs.",
      "matchDepNames": ["pihole/pihole"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "sourceUrl": "https://github.com/pi-hole/docker-pi-hole"
    },
    {
      "description": "linuxserver.io publishes nightly/develop builds into the same tag stream as stable, and ranks them highest under loose versioning. Only accept plain X.Y.Z release tags - those also always point at the newest -lsNNN container build of that app version.",
      "matchDepNames": [
        "linuxserver/jellyfin",
        "linuxserver/radarr",
        "linuxserver/sonarr",
        "linuxserver/prowlarr"
      ],
      "versioning": "loose",
      "allowedVersions": "/^\\d+(\\.\\d+)*$/"
    },
    {
      "description": "Point linuxserver wrapper images at the upstream app repo so PR bodies show the app's own changelog, not the container build notes.",
      "matchDepNames": ["linuxserver/jellyfin"],
      "sourceUrl": "https://github.com/jellyfin/jellyfin"
    },
    {
      "matchDepNames": ["linuxserver/radarr"],
      "sourceUrl": "https://github.com/Radarr/Radarr"
    },
    {
      "matchDepNames": ["linuxserver/sonarr"],
      "sourceUrl": "https://github.com/Sonarr/Sonarr"
    },
    {
      "matchDepNames": ["linuxserver/prowlarr"],
      "sourceUrl": "https://github.com/Prowlarr/Prowlarr"
    },
    {
      "matchDepNames": ["sealed-secrets"],
      "sourceUrl": "https://github.com/bitnami-labs/sealed-secrets"
    },
    {
      "matchDepNames": ["qmcgaw/gluetun"],
      "sourceUrl": "https://github.com/qdm12/gluetun"
    },
    {
      "description": "authentik chart changelog lives in the main authentik repo, not the Helm chart repo.",
      "matchDepNames": ["authentik"],
      "matchManagers": ["helmv3"],
      "sourceUrl": "https://github.com/goauthentik/authentik"
    }
  ]
}
