{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "kubectl get *": "allow",
      "kubectl logs *": "allow",
      "git push*": "ask",
      "git commit*": "ask",
      "kubectl apply*": "ask",
      "kubectl patch*": "ask",
      "kubectl edit*": "ask",
      "kubectl rollout*": "ask",
      "kubectl scale*": "ask",
      "kubectl create*": "ask",
      "kubectl annotate*": "ask",
      "helm install*": "ask",
      "helm upgrade*": "ask",
      "helm rollback*": "ask",
      "kubeseal*": "ask",
      "ansible-playbook*": "ask",
      "ansible *": "ask",
      "ssh *": "ask",
      "*/generate-secret.sh*": "ask",
      "docker *": "ask",
      "open *": "ask",
      "osascript *": "ask",
      "kubectl delete*": "deny",
      "helm uninstall*": "deny",
      "git push --force*": "deny",
      "git reset --hard*": "deny",
      "sudo *": "deny"
    },
    "read": {
      "*": "allow",
      "./*/secrets/**": "deny"
    },
    "edit": {
      "*": "allow",
      "~/.kube/config": "deny",
      "~/.ssh/**": "deny"
    },
    "webfetch": "allow"
  }
}
