      "description": "Age of the least recently backed-up volume. Daily backups should keep this under ~26h.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(time() - (longhorn_volume_last_backup_at > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 93600,
                "color": "orange"
              },
              {
                "value": 172800,
                "color": "red"
              }
            ]
          },
          "noValue": "No backups yet"
