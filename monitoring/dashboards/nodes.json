      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Stalled time (pressure)",
      "description": "Share of time tasks were stuck waiting for CPU, memory or disk (Linux PSI). A few % is normal; sustained >10% means that resource is the bottleneck.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_pressure_cpu_waiting_seconds_total{instance=~\"$node\"}[5m])",
          "legendFormat": "{{instance}} cpu",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_pressure_memory_waiting_seconds_total{instance=~\"$node\"}[5m])",
          "legendFormat": "{{instance}} memory",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_pressure_io_waiting_seconds_total{instance=~\"$node\"}[5m])",
          "legendFormat": "{{instance}} io",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
