    {
      "id": 2,
      "type": "stat",
      "title": "Failed logins (5m)",
      "description": "Failed logins in the last 5 minutes. A few are typos; the alert fires above 5 and goes critical above 20 (brute force).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(authentik_events_recent{action=\"login_failed\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "orange"
              },
              {
                "value": 6,
                "color": "red"
              }
            ]
          },
          "noValue": "No data (not scraped yet)"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
