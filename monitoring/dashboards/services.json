      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "Share of block reads served from memory instead of disk. Below ~95% on a database this small means it is short of RAM.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(pg_stat_database_blks_hit{datname=\"authentik\"}) / (sum(pg_stat_database_blks_hit{datname=\"authentik\"}) + sum(pg_stat_database_blks_read{datname=\"authentik\"}))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 0.9,
                "color": "orange"
              },
              {
                "value": 0.95,
                "color": "green"
              }
            ]
          },
          "noValue": "No data (not scraped yet)",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
