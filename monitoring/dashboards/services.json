    {
      "id": 9,
      "type": "timeseries",
      "title": "Slowest views (p95)",
      "description": "95th-percentile response time of the five slowest Authentik views. Login-flow views creeping up means users wait on every gated page.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(5, histogram_quantile(0.95, sum by (le, view) (rate(django_http_requests_latency_seconds_by_view_method_bucket[5m]))))",
          "legendFormat": "{{view}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
