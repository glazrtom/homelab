      "type": "stat",
      "title": "Software transcodes",
      "description": "Transcodes NOT using hardware acceleration. Above 0 means QuickSync is not being used and the CPU is doing video encoding.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
