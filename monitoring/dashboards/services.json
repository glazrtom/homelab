      "title": "Database size",
      "description": "On-disk size of the authentik database. Mostly the events table; authentik prunes it on a schedule.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pg_database_size_bytes{datname=\"authentik\"}",
          "legendFormat": "",
