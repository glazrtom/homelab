{
  "plansDirectory": ".claude/plans",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,

    "filesystem": {
      "allowWrite": [
        "~/.kube/cache",
        "~/Library/Caches/helm",
        "~/.config/helm",
        "~/.cache/helm",
        "~/.ansible"
      ],
      "denyWrite": [
        "~/.kube/config",
        "~/.ssh"
      ],
      "denyRead": [
        "./*/secrets/**"
      ]
    },

    "network": {
      "allowedDomains": [
        "10.0.0.1",
        "github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "ghcr.io",
        "bitnami.github.io",
        "charts.goauthentik.io",
        "metallb.github.io",
        "emberstack.github.io",
        "kubernetes.github.io",
        "cloudflare.github.io",
        "get.k3s.io"
      ]
    },

    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.config/gh", "mode": "deny" }
      ]
    },

    "excludedCommands": [
      "docker *",
      "open *",
      "osascript *"
    ]
  },

  "permissions": {
    "allow": [
      "Bash(kubectl get *)",
      "Bash(kubectl logs *)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:longhorn.io)",
      "WebFetch(domain:charts.longhorn.io)",
      "WebFetch(domain:charts.bitnami.com)",
      "WebFetch(domain:traefik.github.io)",
      "WebFetch(domain:pkgs.tailscale.com)",
      "WebFetch(domain:hub.docker.com)",
      "WebFetch(domain:docs.pi-hole.net)",
      "WebFetch(domain:docs.renovatebot.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:galaxy.ansible.com)",
      "WebFetch(domain:index.docker.io)",
      "WebFetch(domain:auth.docker.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:metallb.io)",
      "WebFetch(domain:newreleases.io)",
      "WebFetch(domain:docs.goauthentik.io)",
      "WebFetch(domain:release-assets.githubusercontent.com)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(kubectl apply*)",
      "Bash(kubectl patch*)",
      "Bash(kubectl edit*)",
      "Bash(kubectl rollout*)",
      "Bash(kubectl scale*)",
      "Bash(kubectl create*)",
      "Bash(kubectl annotate*)",
      "Bash(helm install*)",
      "Bash(helm upgrade*)",
      "Bash(helm rollback*)",
      "Bash(kubeseal*)",
      "Bash(ansible-playbook*)",
      "Bash(ansible *)",
      "Bash(ssh *)",
      "Bash(cloudflared *)"
    ],
    "deny": [
      "Bash(kubectl delete*)",
      "Bash(helm uninstall*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(sudo *)",
      "Bash(*/generate-secret.sh*)",
      "Read(./*/secrets/**)"
    ]
  }
}
