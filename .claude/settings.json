{
  "plansDirectory": ".claude/plans",
  "env": {
    "NO_PROXY": "localhost,127.0.0.1,::1,169.254.0.0/16",
    "no_proxy": "localhost,127.0.0.1,::1,169.254.0.0/16"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,

    "filesystem": {
      "allowWrite": [
        "~/.kube/cache",
        "~/Library/Caches/helm",
        "~/.config/helm",
        "~/.cache/helm",
        "~/.ansible"
      ],
      "denyWrite": [
        "~/.kube/config",
        "~/.ssh"
      ],
      "denyRead": [
        "./*/secrets/**"
      ]
    },

    "network": {
      "allowedDomains": [
        "10.0.0.1",
        "argo.internal",
        "auth.internal",
        "longhorn.internal",
        "argo-ci.glazrtom.cz",
        "api.github.com",
        "registry.npmjs.org",
        "github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "ghcr.io",
        "bitnami.github.io",
        "charts.goauthentik.io",
        "charts.longhorn.io",
        "longhorn.io",
        "index.docker.io",
        "auth.docker.io",
        "galaxy.ansible.com",
        "metallb.github.io",
        "emberstack.github.io",
        "kubernetes.github.io",
        "cloudflare.github.io",
        "get.k3s.io"
      ]
    },

    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.config/gh", "mode": "deny" }
      ]
    },

    "excludedCommands": [
      "docker *",
      "open *",
      "osascript *",
      "gh *"
    ]
  },

  "enabledMcpjsonServers": [
    "kubernetes"
  ],

  "permissions": {
    "allow": [
      "Bash(helm dependency *)",
      "Bash(helm template *)",
      "Bash(gh run *)",
      "Bash(kubectl config *)",
      "Bash(kubectl get *)",
      "Bash(kubectl logs *)",
      "Bash(gh issue *)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh workflow list*)",
      "mcp__kubernetes__pods_list",
      "mcp__kubernetes__pods_list_in_namespace",
      "mcp__kubernetes__pods_get",
      "mcp__kubernetes__pods_log",
      "mcp__kubernetes__pods_top",
      "mcp__kubernetes__resources_list",
      "mcp__kubernetes__resources_get",
      "mcp__kubernetes__events_list",
      "mcp__kubernetes__namespaces_list",
      "mcp__kubernetes__nodes_log",
      "mcp__kubernetes__nodes_top",
      "mcp__kubernetes__nodes_stats_summary",
      "mcp__kubernetes__configuration_contexts_list",
      "mcp__kubernetes__configuration_view",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:longhorn.io)",
      "WebFetch(domain:charts.longhorn.io)",
      "WebFetch(domain:charts.bitnami.com)",
      "WebFetch(domain:traefik.github.io)",
      "WebFetch(domain:pkgs.tailscale.com)",
      "WebFetch(domain:hub.docker.com)",
      "WebFetch(domain:docs.pi-hole.net)",
      "WebFetch(domain:docs.renovatebot.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:galaxy.ansible.com)",
      "WebFetch(domain:index.docker.io)",
      "WebFetch(domain:auth.docker.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:metallb.io)",
      "WebFetch(domain:newreleases.io)",
      "WebFetch(domain:docs.goauthentik.io)",
      "WebFetch(domain:release-assets.githubusercontent.com)",
      "WebFetch(domain:wiki.servarr.com)"
    ],
    "ask": [
      "Bash(kubectl apply*)",
      "Bash(kubectl patch*)",
      "Bash(kubectl edit*)",
      "Bash(kubectl rollout*)",
      "Bash(kubectl scale*)",
      "Bash(kubectl create*)",
      "Bash(kubectl annotate*)",
      "Bash(helm install*)",
      "Bash(helm upgrade*)",
      "Bash(helm rollback*)",
      "Bash(kubeseal*)",
      "Bash(ansible-playbook*)",
      "Bash(ansible *)",
      "Bash(ssh *)",
      "Bash(*/generate-secret.sh*)"
    ],
    "deny": [
      "Bash(kubectl delete*)",
      "Bash(helm uninstall*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(sudo *)",
      "Read(./*/secrets/**)"
    ]
  }
}
